FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205
RUN apt-get update && apt-get install -y --no-install-recommends git ffmpeg openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /evolution
ENV NODE_ENV=development DATABASE_PROVIDER=postgresql
COPY package.json package-lock.json ./
COPY Docker/scripts/bound-signal-caches.cjs ./Docker/scripts/bound-signal-caches.cjs
COPY Docker/scripts/verify-node-runtime.cjs ./Docker/scripts/verify-node-runtime.cjs
RUN npm ci
RUN node ./Docker/scripts/verify-node-runtime.cjs
COPY prisma ./prisma
COPY runWithProvider.js ./
RUN npm run db:generate
